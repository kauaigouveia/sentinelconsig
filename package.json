    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/exceljs": "^1.3.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.1",
