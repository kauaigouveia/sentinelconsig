rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Allow read and write access for application collections
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    match /promoters/{promoterId} {
      allow read, write: if isValidId(promoterId);
    }

    match /banks/{bankId} {
      allow read, write: if isValidId(bankId);
    }

    match /bank_promoters/{bpId} {
      allow read, write: if isValidId(bpId);
    }

    match /partners/{partnerId} {
      allow read, write: if isValidId(partnerId);
    }

    match /products/{productId} {
      allow read, write: if isValidId(productId);
    }

    match /clients/{clientId} {
      allow read, write: if isValidId(clientId);
    }

    match /proposals/{proposalId} {
      allow read, write: if isValidId(proposalId);
    }

    match /proposal_relations/{relationId} {
      allow read, write: if isValidId(relationId);
    }

    match /statuses/{statusId} {
      allow read, write: if isValidId(statusId);
    }

    match /history/{historyId} {
      allow read, write: if isValidId(historyId);
    }

    match /pendings/{pendingId} {
      allow read, write: if isValidId(pendingId);
    }

    match /holidays/{holidayId} {
      allow read, write: if isValidId(holidayId);
    }

    match /notifications/{notifId} {
      allow read, write: if isValidId(notifId);
    }

    match /audit_logs/{auditId} {
      allow read, write: if isValidId(auditId);
    }

    match /simulation_requests/{simId} {
      allow read, write: if isValidId(simId);
    }

    // Default deny for non-app collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

