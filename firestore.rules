rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Allow authenticated and validated read and write access for application collections
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow write: if isValidId(userId);
    }

    match /promoters/{promoterId} {
      allow get: if isValidId(promoterId);
      allow list: if true;
      allow write: if isValidId(promoterId);
    }

    match /banks/{bankId} {
      allow get: if isValidId(bankId);
      allow list: if true;
      allow write: if isValidId(bankId);
    }

    match /bank_promoters/{bpId} {
      allow get: if isValidId(bpId);
      allow list: if true;
      allow write: if isValidId(bpId);
    }

    match /partners/{partnerId} {
      allow get: if isValidId(partnerId);
      allow list: if true;
      allow write: if isValidId(partnerId);
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow write: if isValidId(productId);
    }

    match /clients/{clientId} {
      allow get: if isValidId(clientId);
      allow list: if true;
      allow write: if isValidId(clientId);
    }

    match /proposals/{proposalId} {
      allow get: if isValidId(proposalId);
      allow list: if true;
      allow write: if isValidId(proposalId);
    }

    match /proposal_relations/{relationId} {
      allow get: if isValidId(relationId);
      allow list: if true;
      allow write: if isValidId(relationId);
    }

    match /statuses/{statusId} {
      allow get: if isValidId(statusId);
      allow list: if true;
      allow write: if isValidId(statusId);
    }

    match /history/{historyId} {
      allow get: if isValidId(historyId);
      allow list: if true;
      allow write: if isValidId(historyId);
    }

    match /comments/{commentId} {
      allow get: if isValidId(commentId);
      allow list: if true;
      allow write: if isValidId(commentId);
    }

    match /pendings/{pendingId} {
      allow get: if isValidId(pendingId);
      allow list: if true;
      allow write: if isValidId(pendingId);
    }

    match /holidays/{holidayId} {
      allow get: if isValidId(holidayId);
      allow list: if true;
      allow write: if isValidId(holidayId);
    }

    match /notifications/{notifId} {
      allow get: if isValidId(notifId);
      allow list: if true;
      allow write: if isValidId(notifId);
    }

    match /audit_logs/{auditId} {
      allow get: if isValidId(auditId);
      allow list: if true;
      allow write: if isValidId(auditId);
    }

    match /simulation_requests/{simId} {
      allow get: if isValidId(simId);
      allow list: if true;
      allow write: if isValidId(simId);
    }

    match /tenants/{tenantId} {
      allow get: if isValidId(tenantId);
      allow list: if true;
      allow write: if isValidId(tenantId);
    }

    match /documents/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow write: if isValidId(docId);
    }

    match /communications/{commId} {
      allow get: if isValidId(commId);
      allow list: if true;
      allow write: if isValidId(commId);
    }

    match /client_notes/{noteId} {
      allow get: if isValidId(noteId);
      allow list: if true;
      allow write: if isValidId(noteId);
    }

    match /operational_tasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow write: if isValidId(taskId);
    }

    match /financial_entries/{finId} {
      allow get: if isValidId(finId);
      allow list: if true;
      allow write: if isValidId(finId);
    }

    match /achievements/{achId} {
      allow get: if isValidId(achId);
      allow list: if true;
      allow write: if isValidId(achId);
    }

    match /backup_snapshots/{snapId} {
      allow get: if isValidId(snapId);
      allow list: if true;
      allow write: if isValidId(snapId);
    }

    // Default deny for unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
