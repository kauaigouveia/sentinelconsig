# PostgreSQL Connection String (Neon Pooled connection for server queries)
DATABASE_URL=

# Direct PostgreSQL Connection String (Neon Direct connection for Prisma migrations)
DIRECT_URL=

# Initial Platform Master Credentials (Used for Idempotent Database Bootstrap)
INITIAL_MASTER_EMAIL=
INITIAL_MASTER_PASSWORD=
-e 
# Realtime Provider Configuration (pusher ou sse)
VITE_REALTIME_PROVIDER=pusher

# Pusher Credentials (Backend)
PUSHER_APP_ID=mock-app-id
PUSHER_SECRET=mock-secret

# Pusher Public Credentials (Frontend)
VITE_PUSHER_KEY=mock-key
VITE_PUSHER_CLUSTER=mock-cluster
