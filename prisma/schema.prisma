// Prisma Schema for Sentinel Consig SaaS
// Multi-tenant, Enterprise Loan Management Platform
// Compatible with PostgreSQL (Neon, Supabase, Cloud SQL, AWS RDS)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  PLATFORM_MASTER
  MASTER
  TENANT_ADMIN
  GESTOR
  GERENTE
  SUPORTE
  DIGITADOR
  SIMULACAO
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
  PENDING_DELETION
}

enum SubscriptionPlan {
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

enum ProposalType {
  NOVO
  REFIN
  PORTABILIDADE
  REFIN_PORTABILIDADE
  CARTAO_RMC
  CARTAO_RCC
  SAQUE_COMPLEMENTAR
}

enum StandardStatusCategory {
  ESTEIRA
  ANDAMENTO
  PENDENTE
  PAGO
  CANCELADO
  RECUSADO
}

enum FinancialEntryType {
  ENTRADA
  SAIDA
}

enum FinancialStatus {
  PREVISTO
  REALIZADO
  CANCELADO
}

enum BackupType {
  AUTOMATIC
  MANUAL
  PRE_RESTORE
  PRE_DELETION
  GLOBAL_SNAPSHOT
}

enum BackupStatus {
  COMPLETED
  FAILED
  IN_PROGRESS
  CORRUPTED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  SLA
  TASK
  PROPOSAL
  CIP
  SYSTEM
  ADMIN
}

enum DocumentType {
  RG
  CNH
  COMPROVANTE_RESIDENCIA
  COMPROVANTE_RENDA
  EXTRATO_INSS
  CONTRATO_ASSINADO
  PROCURACAO
  OUTROS
}

enum ImportJobType {
  PROPOSALS
  STATUS_UPDATE
  SIMULATIONS
  PARTNERS
}

enum ImportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ==========================================
// MULTI-TENANCY & WHITE LABEL
// ==========================================

model Tenant {
  id             String           @id @default(cuid())
  name           String
  tradeName      String?          @map("trade_name")
  cnpj           String?          @unique
  slug           String           @unique
  customDomain   String?          @unique @map("custom_domain")
  status         TenantStatus     @default(ACTIVE)
  plan           SubscriptionPlan @default(PRO)
  maxUsers       Int              @default(10) @map("max_users")
  storageLimitMb Int              @default(5000) @map("storage_limit_mb")
  maxProposals   Int              @default(10000) @map("max_proposals")
  enabledModules String[]         @default(["PROPOSALS", "SIMULATION", "KANBAN", "CRM", "FINANCIAL", "RADAR", "TV_MONITOR"]) @map("enabled_modules")
  simulationAccessEnabled Boolean  @default(true) @map("simulation_access_enabled")
  happySimulationAccessEnabled Boolean @default(true) @map("happy_simulation_access_enabled")

  // White Label Settings
  whiteLabel WhiteLabelConfig?

  // Subscriptions & Limits
  subscriptions Subscription[]

  // Core Relations
  users              User[]
  partners           Partner[]
  partnerInteractions PartnerInteraction[]
  partnerNotes       PartnerNote[]
  partnerTasks       PartnerTask[]
  promoters          Promoter[]
  banks              Bank[]
  bankPromoters      BankPromoter[]
  products           Product[]
  clients            Client[]
  proposals          Proposal[]
  ades               ADE[]
  statusHistories    StatusHistory[]
  comments           Comment[]
  documents          ClientDocument[]
  clientNotes        ClientNote[]
  clientCommunications ClientCommunication[]
  statuses           ProposalStatus[]
  tasks              Task[]
  notifications      Notification[]
  financialEntries   FinancialEntry[]
  auditLogs          AuditLog[]
  backups            Backup[]
  systemConfigs      SystemConfig[]
  importJobs         ImportJob[]
  domains            TenantDomain[]
  simulationRequests SimulationRequest[]
  memberships        UserTenantMembership[]
  convenios          Convenio[]
  operationalRules   OperationalRule[]

  // Soft Delete & Timestamps
  deletedAt     DateTime?      @map("deleted_at")
  deletedBy     String?        @map("deleted_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  announcements     Announcement[]
  monitoredServices MonitoredService[]
  apiIncidents      ApiIncident[]
  c6SyncHistories   C6SyncHistory[]
  factaSyncHistories FactaSyncHistory[]
  happyWebhookEvents HappyWebhookEvent[]
  happySyncHistories HappySyncHistory[]
  pendencies         Pendency[]
  automations        Automation[]
  automationExecutions AutomationExecution[]
  integrationHealthLogs IntegrationHealthLog[]
  intelligenceInsights IntelligenceInsight[]
  intelligenceRuleConfigs IntelligenceRuleConfig[]
  incidents          Incident[]
  incidentTimelineEvents IncidentTimelineEvent[]
  incidentSlaConfigs IncidentSlaConfig[]
  incidentInsights   IncidentInsight[]
  incidentPendencies IncidentPendency[]
  incidentProposals  IncidentProposal[]
  incidentPartners   IncidentPartner[]
  incidentIntegrations IncidentIntegration[]
  partnerPortalAccesses PartnerPortalAccess[]
  partnerPortalSessions PartnerPortalSession[]
  supportConversations SupportConversation[]
  supportMessages      SupportMessage[]

  @@index([slug])
  @@index([customDomain])
  @@index([status])
  @@map("tenants")
}

model WhiteLabelConfig {
  id       String @id @default(cuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  companyName    String  @map("company_name")
  legalName      String? @map("legal_name")
  logoUrl        String? @map("logo_url")
  faviconUrl     String? @map("favicon_url")
  primaryColor   String  @default("#2563eb") @map("primary_color")
  secondaryColor String  @default("#1e40af") @map("secondary_color")
  accentColor    String  @default("#3b82f6") @map("accent_color")
  supportEmail   String? @map("support_email")
  supportPhone   String? @map("support_phone")
  footerText     String? @map("footer_text")
  themeMode      String  @default("LIGHT") @map("theme_mode") // LIGHT, DARK, AUTO

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("white_label_configs")
}

model Subscription {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  plan           SubscriptionPlan
  status         String           @default("ACTIVE") // ACTIVE, OVERDUE, CANCELLED
  validUntil     DateTime?        @map("valid_until")
  userQuota      Int              @map("user_quota")
  proposalQuota  Int              @map("proposal_quota")
  storageQuotaMb Int              @map("storage_quota_mb")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("subscriptions")
}

// ==========================================
// IDENTITY, RBAC & SESSIONS
// ==========================================

model User {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  role              UserRole @default(DIGITADOR)
  active            Boolean  @default(true)
  isMasterProtected Boolean  @default(false) @map("is_master_protected")
  phone             String?
  avatarUrl         String?  @map("avatar_url")

  // Role & Permissions override
  customPermissions String[] @default([]) @map("custom_permissions")

  // Audit Relations
  createdProposals                   Proposal[]          @relation("CreatedProposals")
  assignedProposals                  Proposal[]          @relation("AssignedProposals")
  statusHistories                    StatusHistory[]
  createdAnnouncements               Announcement[]      @relation("CreatedAnnouncements")
  readAnnouncements                  AnnouncementRead[]  @relation("ReadAnnouncements")
  comments                           Comment[]
  tasks                              Task[]
  notifications                      Notification[]
  auditLogs                          AuditLog[]
  uploadedDocs                       ClientDocument[]
  createdBackups                     Backup[]
  importJobs                         ImportJob[]
  sessions                           Session[]
  createdSimulationRequests          SimulationRequest[] @relation("CreatedSimulationRequests")
  matchedDigitizerSimulationRequests SimulationRequest[] @relation("MatchedDigitizerSimulationRequests")
  memberships                        UserTenantMembership[]
  createdAutomations                 Automation[]        @relation("CreatedAutomations")
  assignedPendencies                 Pendency[]          @relation("AssignedPendencies")
  resolvedPendencies                 Pendency[]          @relation("ResolvedPendencies")
  assignedPartners                   Partner[]           @relation("AssignedPartners")
  partnerInteractions                PartnerInteraction[]
  partnerNotes                       PartnerNote[]
  assignedPartnerTasks               PartnerTask[]       @relation("AssignedPartnerTasks")
  createdPartnerTasks                PartnerTask[]       @relation("CreatedPartnerTasks")
  completedPartnerTasks              PartnerTask[]       @relation("CompletedPartnerTasks")
  resolvedInsights                   IntelligenceInsight[] @relation("ResolvedInsights")
  acknowledgedInsights               IntelligenceInsight[] @relation("AcknowledgedInsights")
  createdIncidents                   Incident[]            @relation("CreatedIncidents")
  assignedIncidents                  Incident[]            @relation("AssignedIncidents")
  acknowledgedIncidents              Incident[]            @relation("IncidentAcknowledgedBy")
  resolvedIncidents                  Incident[]            @relation("IncidentResolvedBy")
  closedIncidents                    Incident[]            @relation("IncidentClosedBy")
  assignedSupportConversations       SupportConversation[] @relation("AssignedSupportConversations")
  supportMessages                    SupportMessage[]

  // Security & Lifecycle
  lastLoginAt          DateTime? @map("last_login_at")
  passwordResetToken   String?   @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  mustChangePassword   Boolean   @default(false) @map("must_change_password")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([email])
  @@index([role])
  @@index([active])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Admin Context Switch Persistence (PLATFORM_MASTER)
  adminTargetTenantId   String?   @map("admin_target_tenant_id")
  adminTargetTenantName String?   @map("admin_target_tenant_name")
  adminSwitchedAt       DateTime? @map("admin_switched_at")
  adminContextExpiresAt DateTime? @map("admin_context_expires_at")

  // Multi-tenant Session Context
  effectiveTenantId     String?   @map("effective_tenant_id")
  effectiveMembershipId String?   @map("effective_membership_id")
  activeRole            String?   @map("active_role")
  activePermissions     String[]  @default([]) @map("active_permissions")

  @@index([userId])
  @@index([token])
  @@index([adminTargetTenantId])
  @@map("sessions")
}

// ==========================================
// BUSINESS ENTITIES & CRM
// ==========================================

model Partner {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  code       String
  promoterId String?   @map("promoter_id")
  promoter   Promoter? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  status     String    @default("ATIVO") // ATIVO, INATIVO
  email      String?
  phone      String?
  document   String?

  assignedUserId String? @map("assigned_user_id")
  assignedUser   User?   @relation("AssignedPartners", fields: [assignedUserId], references: [id], onDelete: SetNull)

  proposals          Proposal[]
  simulationRequests SimulationRequest[]
  pendencies         Pendency[]
  interactions       PartnerInteraction[]
  notes              PartnerNote[]
  tasks              PartnerTask[]
  incidents          Incident[]
  incidentPartners   IncidentPartner[]
  portalAccesses     PartnerPortalAccess[]
  portalSessions     PartnerPortalSession[]
  supportConversations SupportConversation[]

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([code])
  @@index([name])
  @@index([assignedUserId])
  @@map("partners")
}

model PartnerInteraction {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String   @default("LIGAÇÃO") // LIGAÇÃO, WHATSAPP, E-MAIL, REUNIÃO, VISITA, OUTRO
  date        DateTime @default(now())
  subject     String
  description String?
  result      String?
  nextAction  String?  @map("next_action")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([partnerId])
  @@index([userId])
  @@index([date])
  @@map("partner_interactions")
}

model PartnerNote {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([partnerId])
  @@index([authorId])
  @@index([createdAt])
  @@map("partner_notes")
}

model PartnerTask {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("AssignedPartnerTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdById String @map("created_by_id")
  createdBy   User   @relation("CreatedPartnerTasks", fields: [createdById], references: [id], onDelete: Cascade)

  completedById String? @map("completed_by_id")
  completedBy   User?   @relation("CompletedPartnerTasks", fields: [completedById], references: [id], onDelete: SetNull)

  priority    PriorityLevel @default(MEDIUM)
  status      String        @default("PENDENTE") // PENDENTE, EM_ANDAMENTO, CONCLUIDA, CANCELADA
  dueDate     DateTime?     @map("due_date")
  completedAt DateTime?     @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([partnerId])
  @@index([assignedToId])
  @@index([status])
  @@index([dueDate])
  @@map("partner_tasks")
}

model PartnerPortalAccess {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String @map("password_hash")

  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at")

  sessions PartnerPortalSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([partnerId])
  @@index([email])
  @@map("partner_portal_accesses")
}

model PartnerPortalSession {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  partnerPortalAccessId String              @map("partner_portal_access_id")
  partnerPortalAccess   PartnerPortalAccess @relation(fields: [partnerPortalAccessId], references: [id], onDelete: Cascade)

  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([partnerId])
  @@index([partnerPortalAccessId])
  @@index([token])
  @@map("partner_portal_sessions")
}

model SupportConversation {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  partnerId String  @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  proposalId String?   @map("proposal_id")
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  subject  String
  channel  String @default("PORTAL") // PORTAL, WHATSAPP
  status   String @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED

  assignedUserId String? @map("assigned_user_id")
  assignedUser   User?   @relation("AssignedSupportConversations", fields: [assignedUserId], references: [id], onDelete: SetNull)

  lastMessageAt DateTime @default(now()) @map("last_message_at")

  messages SupportMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([partnerId])
  @@index([proposalId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversationId String              @map("conversation_id")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType String  @map("sender_type") // PARTNER, SUPPORT, SYSTEM
  senderId   String? @map("sender_id")
  senderUser User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)
  senderName String? @map("sender_name")

  message           String
  channel           String    @default("PORTAL") // PORTAL, WHATSAPP
  externalMessageId String?   @map("external_message_id")
  readAt            DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([conversationId])
  @@index([senderType])
  @@index([channel])
  @@index([createdAt])
  @@map("support_messages")
}

model Promoter {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  code   String
  status String @default("ATIVO")

  partners      Partner[]
  bankPromoters BankPromoter[]
  proposals     Proposal[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("promoters")
}

model Bank {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  code   String
  color  String? @default("#1e3a8a")
  status String  @default("ATIVO")

  bankPromoters BankPromoter[]
  proposals     Proposal[]
  pendencies    Pendency[]
  incidents     Incident[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("banks")
}

model BankPromoter {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  bankId     String   @map("bank_id")
  bank       Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  promoterId String   @map("promoter_id")
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  login  String
  status String @default("ATIVO")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, bankId, promoterId, login])
  @@index([tenantId])
  @@map("bank_promoters")
}

model Product {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                        String
  code                        String?
  description                 String?
  scope                       String       @default("GLOBAL")
  type                        ProposalType @default(NOVO)
  allowsMultipleAde           Boolean      @default(true) @map("allows_multiple_ade")
  requiresPortabilityRelation Boolean      @default(false) @map("requires_portability_relation")
  active                      Boolean      @default(true)
  convenioIds                 String[]     @default([]) @map("convenio_ids")

  proposals   Proposal[]
  ades        ADE[]
  simulations SimulationRequest[]
  pendencies  Pendency[]
  incidents   Incident[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([scope])
  @@index([active])
  @@map("products")
}

model Convenio {
  id          String   @id @default(cuid())
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?
  scope       String   @default("GLOBAL")
  active      Boolean  @default(true)

  proposals   Proposal[]
  ades        ADE[]
  simulations SimulationRequest[]
  pendencies  Pendency[]
  incidents   Incident[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([scope])
  @@index([active])
  @@map("convenios")
}

model OperationalRule {
  id                    String   @id @default(cuid())
  tenantId              String?  @map("tenant_id")
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name                  String
  description           String?
  scope                 String   @default("GLOBAL")
  active                Boolean  @default(true)

  appliesToAllProducts  Boolean  @default(true) @map("applies_to_all_products")
  productIds            String[] @default([]) @map("product_ids")

  appliesToAllConvenios Boolean  @default(true) @map("applies_to_all_convenios")
  convenioIds           String[] @default([]) @map("convenio_ids")

  minInstallments       Int?     @map("min_installments")
  maxInstallments       Int?     @map("max_installments")
  minContractValue      Decimal? @map("min_contract_value") @db.Decimal(12, 2)
  maxContractValue      Decimal? @map("max_contract_value") @db.Decimal(12, 2)
  requiresCipBalance    Boolean  @default(false) @map("requires_cip_balance")
  allowsMultipleAde     Boolean  @default(true) @map("allows_multiple_ade")

  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([scope])
  @@index([active])
  @@map("operational_rules")
}

model Client {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cpf           String
  fullName      String    @map("full_name")
  phone         String?
  email         String?
  birthDate     DateTime? @map("birth_date")
  benefitNumber String?   @map("benefit_number")
  salary        Decimal?  @db.Decimal(12, 2)
  marginFree    Decimal?  @map("margin_free") @db.Decimal(12, 2)
  marginCard    Decimal?  @map("margin_card") @db.Decimal(12, 2)
  addressStreet String?   @map("address_street")
  addressCity   String?   @map("address_city")
  addressState  String?   @map("address_state")
  addressZip    String?   @map("address_zip")

  proposals Proposal[]
  documents ClientDocument[]
  notes     ClientNote[]
  communications ClientCommunication[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tasks     Task[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([cpf])
  @@index([fullName])
  @@map("clients")
}

model ClientNote {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  authorId   String   @map("author_id")
  authorName String   @map("author_name")
  note       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, clientId, createdAt])
  @@map("client_notes")
}

model ClientCommunication {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId String @map("client_id")
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposalId String? @map("proposal_id")
  proposal Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  channel        String @default("WHATSAPP")
  templateName   String? @map("template_name")
  eventType      String? @map("event_type")
  recipient      String
  messageContent String @map("message_content")
  status         String @default("PENDENTE")
  sentByUserId   String @map("sent_by_user_id")
  sentByUserName String @map("sent_by_user_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, clientId, createdAt])
  @@map("client_communications")
}

model ClientDocument {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clientId   String    @map("client_id")
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposalId String?   @map("proposal_id")
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  name            String
  type            DocumentType @default(OUTROS)
  fileUrl         String       @map("file_url")
  fileSizeBytes   Int          @default(0) @map("file_size_bytes")
  storagePath     String?      @map("storage_path")
  mimeType        String?      @map("mime_type")
  storageProvider String       @default("AZURE_BLOB") @map("storage_provider")

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
