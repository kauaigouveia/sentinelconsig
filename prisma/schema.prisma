// ==========================================
// SENTINEL INTELLIGENCE (FASE 7)
// ==========================================

enum IntelligenceInsightType {
  ANOMALY
  TREND
  CORRELATION
  BOTTLENECK
  INTEGRATION
  SLA
  CONVERSION
  PRODUCTION
  CANCELLATION
  REFUSAL
  PARTNER
  BANK
  PRODUCT
  CONVENIO
  OPERATOR
}

enum IntelligenceSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IntelligenceStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  DISMISSED
}

model IntelligenceInsight {
  id               String                  @id @default(cuid())
  tenantId         String                  @map("tenant_id")
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type             IntelligenceInsightType
  category         String                  // PRODUCTION, CONVERSION, INTEGRATION, SLA, PARTNER, BOTTLENECK, CANCELLATION, REFUSAL, etc.
  severity         IntelligenceSeverity    @default(MEDIUM)
  title            String
  summary          String                  @db.Text
  explanation      String?                 @db.Text
  status           IntelligenceStatus      @default(NEW)
  confidence       Float                   @default(0.8) // 0.0 to 1.0 (evidential strength indicator)
  detectedAt       DateTime                @default(now()) @map("detected_at")

  periodStart      DateTime                @map("period_start")
  periodEnd        DateTime                @map("period_end")
  comparisonStart  DateTime?               @map("comparison_start")
  comparisonEnd    DateTime?               @map("comparison_end")

  entityType       String?                 @map("entity_type") // BANK, PARTNER, PRODUCT, CONVENIO, INTEGRATION, OPERATOR, STATUS
  entityId         String?                 @map("entity_id")
  entityName       String?                 @map("entity_name")

  metadata         Json?
  evidence         Json                    // Array of structured evidence objects
  suggestedActions Json                    // Array of suggested action descriptors
  dedupKey         String                  @map("dedup_key") // Deterministic deduplication hash

  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  
  resolvedAt       DateTime?               @map("resolved_at")
  resolvedById     String?                 @map("resolved_by_id")
  resolvedBy       User?                   @relation("ResolvedInsights", fields: [resolvedById], references: [id], onDelete: SetNull)

  acknowledgedAt   DateTime?               @map("acknowledged_at")
  acknowledgedById String?                 @map("acknowledged_by_id")
  acknowledgedBy   User?                   @relation("AcknowledgedInsights", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  incidentInsights IncidentInsight[]

  @@index([tenantId])
  @@index([dedupKey])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([type])
  @@index([detectedAt])
  @@index([entityType, entityId])
  @@map("intelligence_insights")
}

model IntelligenceRuleConfig {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ruleId      String               @map("rule_id")
  name        String
  category    String
  description String?
  enabled     Boolean              @default(true)
  severity    IntelligenceSeverity @default(MEDIUM)
  threshold   Float?
  config      Json?

  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@unique([tenantId, ruleId])
  @@index([tenantId])
  @@index([ruleId])
  @@index([enabled])
  @@map("intelligence_rule_configs")
}

// ==========================================
// FASE 8: SENTINEL COMMAND CENTER
// ==========================================

enum IncidentType {
  INTEGRATION
  PRODUCTION
  CONVERSION
  SLA
  PARTNER
  PROPOSAL
  SIMULATION
  SYSTEM
  SECURITY
  OPERATIONAL
  INTELLIGENCE
}

enum IncidentSource {
  INTELLIGENCE
  INTEGRATION
  BI
  PENDENCY
  AUTOMATION
  SYSTEM
  MANUAL
}

model Incident {
  id                     String            @id @default(cuid())
  tenantId               String            @map("tenant_id")
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  incidentNumber         String            @map("incident_number") // e.g. INC-2026-0001
  title                  String
  description            String?           @db.Text
  type                   IncidentType      @default(OPERATIONAL)
  severity               IncidentSeverity  @default(MEDIUM)
  status                 IncidentStatus    @default(OPEN)
  source                 IncidentSource    @default(MANUAL)

  dedupKey               String?           @map("dedup_key") // Deterministic deduplication hash

  // Impact Dimensions
  bankId                 String?           @map("bank_id")
  bank                   Bank?             @relation(fields: [bankId], references: [id], onDelete: SetNull)
  productId              String?           @map("product_id")
  product                Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  convenioId             String?           @map("convenio_id")
  convenio               Convenio?         @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  partnerId              String?           @map("partner_id")
  partner                Partner?          @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  integrationSlug        String?           @map("integration_slug") // c6, facta, bmg, happy

  // Financial and Operational Impact (Calculated snapshot)
  impactProposalsCount   Int               @default(0) @map("impact_proposals_count")
  impactProposalsVolume  Decimal           @default(0) @map("impact_proposals_volume") @db.Decimal(14, 2)
  impactSimulationsCount Int               @default(0) @map("impact_simulations_count")
  impactPartnersCount    Int               @default(0) @map("impact_partners_count")
  impactSummary          String?           @db.Text @map("impact_summary")

  // SLA & Timeline Tracking
  slaMinutesTarget       Int               @default(240) @map("sla_minutes_target")
  slaAcknowledgeTarget   Int               @default(30) @map("sla_acknowledge_target")
  slaDeadline            DateTime?         @map("sla_deadline")

  acknowledgedAt         DateTime?         @map("acknowledged_at")
  acknowledgedById       String?           @map("acknowledged_by_id")
  acknowledgedBy         User?             @relation("IncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  investigatingAt        DateTime?         @map("investigating_at")
  mitigatingAt           DateTime?         @map("mitigating_at")
  monitoringAt           DateTime?         @map("monitoring_at")

  resolvedAt             DateTime?         @map("resolved_at")
  resolvedById           String?           @map("resolved_by_id")
  resolvedBy             User?             @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes        String?           @db.Text @map("resolution_notes")

  closedAt               DateTime?         @map("closed_at")
  closedById             String?           @map("closed_by_id")
  closedBy               User?             @relation("IncidentClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closureNotes           String?           @db.Text @map("closure_notes")

  assignedToId           String?           @map("assigned_to_id")
  assignedTo             User?             @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt             DateTime?         @map("assigned_at")

  createdById            String?           @map("created_by_id")
  createdBy              User?             @relation("CreatedIncidents", fields: [createdById], references: [id], onDelete: SetNull)

  metadata               Json?
  tags                   String[]          @default([])

  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  // Relations
  timelineEvents         IncidentTimelineEvent[]
  incidentInsights       IncidentInsight[]
  incidentPendencies     IncidentPendency[]
  incidentProposals      IncidentProposal[]
  incidentPartners       IncidentPartner[]
  incidentIntegrations   IncidentIntegration[]

  @@unique([tenantId, incidentNumber])
  @@index([tenantId])
  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([source])
  @@index([assignedToId])
  @@index([dedupKey])
  @@index([createdAt])
  @@map("incidents")
}

model IncidentInsight {
  id         String              @id @default(cuid())
  tenantId   String              @map("tenant_id")
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  incidentId String              @map("incident_id")
  incident   Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  insightId  String              @map("insight_id")
  insight    IntelligenceInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)
  createdAt  DateTime            @default(now()) @map("created_at")

  @@unique([incidentId, insightId])
  @@index([tenantId])
  @@index([incidentId])
  @@index([insightId])
  @@map("incident_insights")
}

model IncidentPendency {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
