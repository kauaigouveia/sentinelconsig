  @@index([tenantId])
  @@index([clientId])
  @@index([proposalId])
  @@map("client_documents")
}

// ==========================================
// PROPOSALS, ADES, STATUS & AUDIT
// ==========================================

model Proposal {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  proposalNumber String @map("proposal_number")
  clientId       String @map("client_id")
  client         Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  partnerId  String?   @map("partner_id")
  partner    Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  promoterId String?   @map("promoter_id")
  promoter   Promoter? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  bankId     String?   @map("bank_id")
  bank       Bank?     @relation(fields: [bankId], references: [id], onDelete: SetNull)
  productId  String?   @map("product_id")
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  convenioId String?   @map("convenio_id")
  convenio   Convenio? @relation(fields: [convenioId], references: [id], onDelete: SetNull)

  type             ProposalType           @default(NOVO)
  statusId         String?                @map("status_id")
  status           ProposalStatus?        @relation(fields: [statusId], references: [id], onDelete: SetNull)
  standardCategory StandardStatusCategory @default(ESTEIRA) @map("standard_category")

  // Financial Values
  releasedValue     Decimal  @default(0) @map("released_value") @db.Decimal(12, 2) // Troco Líquido / Liberado
  contractValue     Decimal  @default(0) @map("contract_value") @db.Decimal(12, 2) // Volume Bruto
  installmentValue  Decimal  @default(0) @map("installment_value") @db.Decimal(12, 2)
  installmentsCount Int      @default(84) @map("installments_count")
  debtBalance       Decimal? @map("debt_balance") @db.Decimal(12, 2) // Saldo Devedor Quitação
  commissionRate    Decimal? @map("commission_rate") @db.Decimal(5, 2)

  // Portability & CIP
  originalBankCode  String?   @map("original_bank_code")
  cipNumber         String?   @map("cip_number")
  cipStatus         String?   @map("cip_status")
  retentionDeadline DateTime? @map("retention_deadline")
  relatedPortabilityId String?  @map("related_portability_id")

  // Ownership & Dates
  createdById  String? @map("created_by_id")
  createdBy    User?   @relation("CreatedProposals", fields: [createdById], references: [id], onDelete: SetNull)
  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("AssignedProposals", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Relations
  ades            ADE[]
  clientCommunications ClientCommunication[]
  statusHistories StatusHistory[]
  comments        Comment[]
  documents       ClientDocument[]

  // C6 Bank Integration Identifiers & Sync Status
  c6ProposalNumber      String?          @map("c6_proposal_number")
  c6OperationNumber     String?          @map("c6_operation_number")
  c6RawSituation        String?          @map("c6_raw_situation")
  c6CurrentActivity     String?          @map("c6_current_activity")
  c6ActivityDescription String?          @map("c6_activity_description")
  c6FormalizationStatus String?          @map("c6_formalization_status")
  c6FormalizationCode   String?          @map("c6_formalization_code")
  c6LastActivityDate    DateTime?        @map("c6_last_activity_date")
  c6LastSyncAt          DateTime?        @map("c6_last_sync_at")
  c6SyncStatus          String?          @default("PENDING") @map("c6_sync_status") // SYNCED, PENDING, ERROR, MISSING_IDENTIFIER
  c6SyncError           String?          @map("c6_sync_error")
  c6RawData             Json?            @map("c6_raw_data")
  c6SyncHistories       C6SyncHistory[]

  // FACTA Integration Identifiers & Sync Status
  factaProposalNumber String?            @map("facta_proposal_number")
  factaAfCode         String?            @map("facta_af_code")
  factaContractNumber String?            @map("facta_contract_number")
  factaRawStatus      String?            @map("facta_raw_status")
  factaCrivoStatus    String?            @map("facta_crivo_status")
  factaLastMovementAt DateTime?          @map("facta_last_movement_at")
  factaLastSyncAt     DateTime?          @map("facta_last_sync_at")
  factaSyncStatus     String?            @default("PENDING") @map("facta_sync_status") // SYNCED, PENDING, ERROR, UNLINKED
  factaSyncError      String?            @map("facta_sync_error")
  factaRawData        Json?              @map("facta_raw_data")
  factaSyncHistories  FactaSyncHistory[]

  // Happy / BYX Capital Integration Identifiers & Sync Status
  happyContractId        String?          @map("happy_contract_id")
  happyStatus            String?          @map("happy_status")
  happyStatusCode        Int?             @map("happy_status_code")
  happyStatusName        String?          @map("happy_status_name")
  happyStatusDescription String?          @map("happy_status_description")
  happyProductType       String?          @map("happy_product_type")
  happyPortabilityStatus String?          @map("happy_portability_status")
  happyDigitizer         String?          @map("happy_digitizer")
  happyProposalKey       String?          @map("happy_proposal_key")
  happyCustomerId        String?          @map("happy_customer_id")
  happyLastSyncAt        DateTime?        @map("happy_last_sync_at")
  happySyncStatus        String?          @default("PENDING") @map("happy_sync_status") // SYNCED, PENDING, ERROR, UNMATCHED
  happySyncError         String?          @map("happy_sync_error")
  happyRawData           Json?            @map("happy_raw_data")
  happySyncHistories     HappySyncHistory[]

  // Concurrency & Soft Delete
  version                   Int                 @default(1)
  deletedAt                 DateTime?           @map("deleted_at")
  deletedBy                 String?             @map("deleted_by")
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  tasks                     Task[]
  notifications             Notification[]
  matchedSimulationRequests SimulationRequest[] @relation("MatchedSimulationRequests")
  pendencies                Pendency[]
  incidentProposals         IncidentProposal[]
  supportConversations      SupportConversation[]

  @@unique([tenantId, proposalNumber])
  @@index([tenantId])
  @@index([proposalNumber])
  @@index([clientId])
  @@index([partnerId])
  @@index([bankId])
  @@index([promoterId])
  @@index([statusId])
  @@index([standardCategory])
  @@index([createdAt])
  @@index([tenantId, statusId, createdAt])
  @@index([tenantId, clientId])
  @@index([tenantId, c6ProposalNumber])
  @@index([c6SyncStatus])
  @@index([tenantId, factaProposalNumber])
  @@index([tenantId, factaAfCode])
  @@index([factaSyncStatus])
  @@index([tenantId, happyContractId])
  @@index([tenantId, happyProposalKey])
  @@index([happySyncStatus])
  @@map("proposals")
}

model ADE {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  adeNumber    String  @map("ade_number")
  value        Decimal @db.Decimal(12, 2)
  installments Int     @default(84)
  bankName     String? @map("bank_name")
  status       String  @default("ATIVA")

  convenioId   String?   @map("convenio_id")
  convenio     Convenio? @relation(fields: [convenioId], references: [id], onDelete: SetNull)
  productId    String?   @map("product_id")
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([proposalId, adeNumber])
  @@index([tenantId])
  @@index([proposalId])
  @@index([adeNumber])
  @@map("ades")
}

model ProposalStatus {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name             String
  code             String
  color            String                 @default("#3b82f6")
  standardCategory StandardStatusCategory @default(ESTEIRA) @map("standard_category")
  slaHours               Int                    @default(24) @map("sla_hours")
  order                  Int                    @default(0)
  active                 Boolean                @default(true)
  responsibleGroup       String                 @default("NOSSA EQUIPE") @map("responsible_group")
  finalStatus            Boolean                @default(false) @map("final_status")
  manualChangeAllowed    Boolean                @default(true) @map("manual_change_allowed")
  automaticChangeAllowed Boolean                @default(true) @map("automatic_change_allowed")

  proposals       Proposal[]
  statusHistories StatusHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([standardCategory])
  @@map("proposal_statuses")
}

model StatusHistory {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  statusId   String?         @map("status_id")
  status     ProposalStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  statusName String          @map("status_name")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([proposalId])
  @@index([statusId])
  @@index([createdAt])
  @@index([proposalId, createdAt])
  @@map("status_histories")
}

model Comment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  proposalId String   @map("proposal_id")
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  userId     String? @map("user_id")
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String  @map("author_name")
  text       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([proposalId])
  @@index([tenantId, createdAt])
  @@map("comments")
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
  CANCELLED
}

model Announcement {
  id          String             @id @default(cuid())
  tenantId    String?            @map("tenant_id")
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String             @map("created_by_id")
  createdBy   User               @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  title       String
  content     String
  priority    PriorityLevel      @default(MEDIUM)
  status      AnnouncementStatus @default(DRAFT)
  publishedAt DateTime?          @map("published_at")
  scheduledAt DateTime?          @map("scheduled_at")
  expiresAt   DateTime?          @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  reads AnnouncementRead[]

  @@index([tenantId])
  @@index([status])
  @@index([publishedAt])
  @@index([expiresAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation("ReadAnnouncements", fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime?    @default(now()) @map("read_at")
  dismissedAt    DateTime?    @map("dismissed_at")

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ==========================================
// TASKS, FINANCIAL & NOTIFICATIONS
// ==========================================

model Task {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    String        @default("OPERACIONAL")
  priority    PriorityLevel @default(MEDIUM)
  dueDate     DateTime?     @map("due_date")
  completed   Boolean       @default(false)

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  proposalId String?   @map("proposal_id")
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  clientId String? @map("client_id")
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([assignedToId])
  @@index([completed])
  @@map("tasks")
}

model FinancialEntry {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  type        FinancialEntryType
  category    String
  title       String
  amount      Decimal            @db.Decimal(12, 2)
  dueDate     DateTime           @map("due_date")
  paymentDate DateTime?          @map("payment_date")
  status      FinancialStatus    @default(PREVISTO)
  notes       String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@map("financial_entries")
}

model Notification {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId     String?          @map("user_id")
  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  message    String
  read       Boolean          @default(false)
  linkUrl    String?          @map("link_url")
  priority   PriorityLevel    @default(MEDIUM)
  type       NotificationType @default(SYSTEM)
  proposalId String?          @map("proposal_id")
  proposal   Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  eventKey String? @map("event_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, eventKey])
  @@index([tenantId])
  @@index([userId])
  @@index([read])
  @@map("notifications")
}

// ==========================================
// AUDIT LOGS, BACKUPS & SYSTEM CONFIG
// ==========================================

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId   String? @map("user_id")
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String? @map("user_name")

  action    String
  entity    String
  entityId  String? @map("entity_id")
  oldData   String? @map("old_data") // JSON
  newData   String? @map("new_data") // JSON
  ipAddress String? @map("ip_address")

  // Hash de Integridade Criptográfica (SHA-256)
  previousHash String? @map("previous_hash")
  recordHash   String? @map("record_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Backup {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

