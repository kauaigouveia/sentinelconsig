// Prisma schema for EVOLVE GESTÃO
// Pronto para deploy na Vercel e conexão com PostgreSQL (ex: Supabase, Neon, RDS, Cloud SQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  GESTOR
  GERENTE
  SUPORTE
  DIGITADOR
}

enum Alcada {
  CLIENTE
  PARCEIRO
  BANCO
  NOSSA_EQUIPE
  SISTEMA
}

enum HistoryOrigin {
  MANUAL
  SISTEMA
  IMPORTACAO
  ALTERACAO_EM_LOTE
}

enum PendingType {
  DOCUMENTACAO
  BANCO
  PARCEIRO
  CLIENTE
  CORBAN
  CIP
  SISTEMA
  OUTROS
}

enum PendingStatus {
  ABERTA
  RESOLVIDA
  CANCELADA
}

enum NotificationPriority {
  NORMAL
  ATENCAO
  URGENTE
}

enum SimulationRequestStatus {
  SIMULACAO_ENVIADA
  NAO_PASSIVEL_DE_CONTRATACAO
  DIGITADA_PELA_MESA
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(DIGITADOR)
  active       Boolean   @default(true)
  avatarUrl    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  proposals          Proposal[]          @relation("DigitizerProposals")
  simulationRequests SimulationRequest[] @relation("CreatedSimulationRequests")
  comments           Comment[]
  auditLogs          AuditLog[]
  exportLogs         ExportLog[]

  @@index([email])
  @@index([role])
}

model Promoter {
  id          String   @id @default(uuid())
  name        String   @unique
  active      Boolean  @default(true)
  observation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  banks       BankPromoter[]
  partners    Partner[]
  proposals   Proposal[]

  @@index([name])
}

model Bank {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String?
  active      Boolean  @default(true)
  observation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promoters   BankPromoter[]
  proposals   Proposal[]

  @@index([name])
}

model BankPromoter {
  id         String   @id @default(uuid())
  bankId     String
  promoterId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bank       Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)

  @@unique([bankId, promoterId])
  @@index([bankId])
  @@index([promoterId])
}

model Partner {
  id                 String              @id @default(uuid())
  fullName           String
  login              String              @unique // Formato NOME@CODIGO (Ex: KAUAI@16740). Código derivado via extractPartnerCode()
  promoterId         String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  promoter           Promoter            @relation(fields: [promoterId], references: [id])
  proposals          Proposal[]
  simulationRequests SimulationRequest[]

  @@index([login])
  @@index([promoterId])
}

model Product {
  id                          String     @id @default(uuid())
  name                        String     @unique
  description                 String?
  active                      Boolean    @default(true)
  type                        String     @default("CONSIGNADO")
  allowsMultipleAde           Boolean    @default(true)
  requiresPortabilityRelation Boolean    @default(false)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt

  proposals                   Proposal[]

  @@index([name])
}

model Client {
  id          String     @id @default(uuid())
  cpf         String     @unique // Armazenar sempre limpo: 11 dígitos sem formatação
  fullName    String
  phone       String?
  email       String?
  observation String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  proposals   Proposal[]
  pendings    Pending[]

  @@index([cpf])
  @@index([fullName])
}

model ProposalStatus {
  id                     String     @id @default(uuid())
  name                   String     @unique
  code                   String     @unique
  active                 Boolean    @default(true)
  order                  Int        @default(0)
  responsibleGroup       Alcada     @default(NOSSA_EQUIPE)
  slaHours               Int        @default(24)
  finalStatus            Boolean    @default(false)
  manualChangeAllowed    Boolean    @default(true)
  automaticChangeAllowed Boolean    @default(true)
  productType            String?
  color                  String     @default("#3b82f6")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  proposals              Proposal[]

  @@index([code])
}

model Proposal {
  id                      String    @id @default(uuid())
  proposalNumber          String    @unique // Número da ADE ou Proposta alfanumérica/UUID
  clientId                String
  productId               String
  bankId                  String
  promoterId              String
  partnerId               String
  digitizerId             String
  statusId                String
  currentResponsible      Alcada    @default(NOSSA_EQUIPE)
  notes                   String?
  portabilitySlaStartedAt DateTime?
  completedAt             DateTime?
  paidAt                  DateTime?
  cancelledAt             DateTime?
  rejectedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  client                  Client         @relation(fields: [clientId], references: [id])
  product                 Product        @relation(fields: [productId], references: [id])
  bank                    Bank           @relation(fields: [bankId], references: [id])
  promoter                Promoter       @relation(fields: [promoterId], references: [id])
  partner                 Partner        @relation(fields: [partnerId], references: [id])
  digitizer               User           @relation("DigitizerProposals", fields: [digitizerId], references: [id])
  status                  ProposalStatus @relation(fields: [statusId], references: [id])

  history                 ProposalStatusHistory[]
  comments                Comment[]
  pendings                Pending[]
  matchedSimulations      SimulationRequest[] @relation("MatchedSimulations")
  
  // Relacionamentos entre propostas (ex: Portabilidade -> Refin da Portabilidade)
  portabilityRelations    ProposalRelation[] @relation("PortabilitySource")
  refinRelations          ProposalRelation[] @relation("RefinTarget")

  @@index([proposalNumber])
  @@index([clientId])
  @@index([productId])
  @@index([bankId])
  @@index([promoterId])
  @@index([partnerId])
  @@index([digitizerId])
  @@index([statusId])
  @@index([createdAt])
}

model ProposalRelation {
  id                    String   @id @default(uuid())
  portabilityProposalId String
  refinProposalId       String
  createdAt             DateTime @default(now())

  portabilityProposal   Proposal @relation("PortabilitySource", fields: [portabilityProposalId], references: [id], onDelete: Cascade)
  refinProposal         Proposal @relation("RefinTarget", fields: [refinProposalId], references: [id], onDelete: Cascade)

  @@unique([portabilityProposalId, refinProposalId])
  @@index([portabilityProposalId])
  @@index([refinProposalId])
}

model ProposalStatusHistory {
  id                 String        @id @default(uuid())
  proposalId         String
  userId             String?
  userName           String
  previousStatusId   String?
  previousStatusName String?
  newStatusId        String
  newStatusName      String
  action             String
  observation        String?
  origin             HistoryOrigin @default(MANUAL)
  createdAt          DateTime      @default(now())

  proposal           Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@index([createdAt])
}

model Comment {
  id         String   @id @default(uuid())
  proposalId String
  userId     String
  userName   String
  userRole   Role
  comment    String
  createdAt  DateTime @default(now())

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])

  @@index([proposalId])
}

model Pending {
  id                  String        @id @default(uuid())
  proposalId          String
  clientId            String
  responsibleUserId   String?
  responsibleUserName String?
  responsibleGroup    Alcada        @default(NOSSA_EQUIPE)
  type                PendingType   @default(DOCUMENTACAO)
  description         String
  openedAt            DateTime      @default(now())
  deadline            DateTime?
  status              PendingStatus @default(ABERTA)
  resolvedAt          DateTime?
  resolvedByUserId    String?
  resolvedByUserName  String?

  proposal            Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  client              Client        @relation(fields: [clientId], references: [id])

  @@index([proposalId])
  @@index([clientId])
  @@index([status])
}

model Holiday {
  id        String   @id @default(uuid())
  date      String   @unique // Formato YYYY-MM-DD
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Notification {
  id         String               @id @default(uuid())
  proposalId String?
  title      String
  message    String
  type       String
  priority   NotificationPriority @default(NORMAL)
  read       Boolean              @default(false)
  createdAt  DateTime             @default(now())

  @@index([read])
  @@index([createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  userName     String
  userRole     Role
  action       String
  entity       String
  entityId     String
  previousData String?  @db.Text
  newData      String?  @db.Text
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model ExportLog {
  id          String   @id @default(uuid())
  userId      String
  userName    String
  productName String
  filters     String   @db.Text
  quantity    Int
  fileName    String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model SystemConfig {
  id                     String   @id @default("default")
  portabilityBalanceDays Int      @default(5)
  autoCronIntervalMin    Int      @default(15)
  updatedAt              DateTime @updatedAt
}

model SimulationRequest {
  id                    String                  @id @default(uuid())
  cpf                   String                  // 11 dígitos normalizados
  partnerId             String
  createdById           String
  status                SimulationRequestStatus @default(SIMULACAO_ENVIADA)
  matchedProposalId     String?
  matchedProposalNumber String?
  matchedDigitizerId    String?
  matchedDigitizerName  String?
  matchedAt             DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  partner               Partner                 @relation(fields: [partnerId], references: [id])
  createdBy             User                    @relation("CreatedSimulationRequests", fields: [createdById], references: [id])
  matchedProposal       Proposal?               @relation("MatchedSimulations", fields: [matchedProposalId], references: [id])

  @@index([cpf])
  @@index([partnerId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}
