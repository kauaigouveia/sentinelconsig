  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([domain])
  @@map("tenant_domains")
}

// ==========================================
// SIMULATION REQUESTS (Central de Simulações)
// ==========================================

model SimulationRequest {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cpf       String
  partnerId String?  @map("partner_id")
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  createdById String @map("created_by_id")
  createdBy   User   @relation("CreatedSimulationRequests", fields: [createdById], references: [id], onDelete: Cascade)

  status          String  @default("SIMULAÇÃO ENVIADA")
  rejectionReason String? @map("rejection_reason")

  simulationType  String  @default("MANUAL") @map("simulation_type") // MANUAL, HAPPY_INSS, HAPPY_CLT
  operationType   String? @map("operation_type") // MARGEM_LIVRE, PORTABILIDADE_REFIN, CONSIGNADO_PRIVADO_CLT

  // Happy / BYX Capital specific attributes
